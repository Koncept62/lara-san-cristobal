---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';

const path = Astro.url.pathname;
const listings = (await getCollection('land'))
  .sort((a, b) => a.data.propertyName.localeCompare(b.data.propertyName));
---
<Layout
  title="Terrenos en venta · Lara San Cristóbal"
  description="Terrenos en venta en San Cristóbal de las Casas — parcelas residenciales en Los Alcanfores, San Nicolás y Corral de Piedra, y predios rurales más amplios en las tierras altas de Chiapas."
  lang="es"
  enHref="/land-for-sale"
>
  <Header lang="es" enHref="/land-for-sale" />
  <MobileMenu currentPath={path} lang="es" />

  <section id="top" style="position: relative; min-height: 78vh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding: clamp(110px, 16vh, 180px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 72px);">
    <div style="position: absolute; inset: 0; overflow: hidden;">
      <img src="https://res.cloudinary.com/disybpuro/image/upload/w_2000/f_auto,q_auto/v1788460287/LSC_22_small_bar8ti.jpg" alt="Terreno en las montañas al atardecer fuera de San Cristóbal" style="width: 100%; height: 100%; object-fit: cover; object-position: center 45%;" />
      <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(34, 31, 28, 0.34) 0%, rgba(34, 31, 28, 0.3) 40%, rgba(34, 31, 28, 0.66) 100%);"></div>
    </div>
    <div style="position: relative; max-width: 1400px; width: 100%; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(251, 248, 243, 0.72);">Terrenos en venta</span>
        <h1 style="margin: 0; max-width: 18ch; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(35px, 5.10vw, 84px); line-height: 1.06; letter-spacing: 0.005em; color: #FBF8F3; text-wrap: pretty;">Un valor excepcional y vistas que rara vez se encuentran en otro lugar</h1>
        <p style="margin: 0; font-size: clamp(17px, 1.7vw, 25px); font-weight: 300; line-height: 1.45; letter-spacing: 0.005em; color: rgba(251, 248, 243, 0.9);">Terrenos extraordinarios a precios sensatos…</p>
      </div>
      <p style="margin: 0 0 10px; max-width: 36ch; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(251, 248, 243, 0.86);">El terreno en San Cristóbal y sus alrededores es una inversión sensata y muy atractiva, con predios excepcionalmente bellos disponibles.</p>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(70px, 12vh, 150px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 80px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 86px); align-items: start;">
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(23px, 2.46vw, 35px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;">Que los precios sean bajos hoy no significa que vayan a quedarse así: este es sin duda un mercado al alza, e invertir hoy debería darte muy buenos resultados mañana.</p>
      <div style="display: flex; flex-direction: column; gap: 24px; padding-top: 8px;">
        <p style="margin: 0; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">Los hay con una relación calidad-precio realmente sobresaliente, además de naturaleza y vistas que rara vez se encuentran en otro lugar.</p>
        <a href="#enquire" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Pregunta qué hay disponible</a>
      </div>
    </div>
  </section>

  {listings.length > 0 && (
    <section data-reveal="1" style="padding: clamp(20px, 4vh, 40px) clamp(20px, 4vw, 56px) clamp(50px, 8vh, 90px);">
      <div style="max-width: 1400px; margin: 0 auto;">
        <div style="display: flex; padding-bottom: 40px; border-bottom: 1px solid rgba(43, 38, 34, 0.14);">
          <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Disponible ahora</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(28px, 3.4vw, 54px); padding-top: clamp(34px, 4vw, 56px);">
          {listings.map(entry => {
            const slug = entry.id.replace(/\.md$/, '');
            const d = entry.data;
            return (
              <a href={`/land-es/${slug}`} style="display: flex; flex-direction: column; gap: 20px;">
                <div style="position: relative; overflow: hidden; aspect-ratio: 3 / 4; background: #E4D8C8;">
                  <img src={d.mainImage} alt={d.propertyName} style="width: 100%; height: 100%; object-fit: cover; object-position: center 45%;" />
                  {d.status === 'Reserved' && <span style="position: absolute; top: 16px; left: 16px; background: rgba(34, 31, 28, 0.78); padding: 6px 12px; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6;">Reservado</span>}
                  {d.status === 'Sold' && <span style="position: absolute; top: 16px; left: 16px; background: rgba(34, 31, 28, 0.78); padding: 6px 12px; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6;">Vendido</span>}
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <h3 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 24px; line-height: 1.2;">{d.propertyName}</h3>
                  <p style="margin: 0; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #6E655C;">{d.location} · {d.landSize}</p>
                  <p style="margin: 4px 0 0; font-size: 14px; font-weight: 300; line-height: 1.75; color: #6E655C;">{d.inBrief}</p>
                  <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 4px;">
                    {d.priceMxn ? (
                      <>
                        <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 400; letter-spacing: 0.005em; color: #c15857;">{d.priceMxn}</span>
                        {d.priceUsd && <span style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8C8175;">≈ {d.priceUsd} USD aprox.</span>}
                      </>
                    ) : (
                      <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #c15857;">Precio a consultar</span>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section data-reveal="1" style="padding: clamp(30px, 5vh, 60px) clamp(20px, 4vw, 56px) clamp(60px, 9vh, 110px);">
    <div style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(30px, 4vw, 46px);">
      <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 30px; border-bottom: 1px solid rgba(43, 38, 34, 0.14);">
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Qué hay disponible</h2>
        <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #6E655C;">De 1,000 m² a laderas completas</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: rgba(43, 38, 34, 0.14);">
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 300; color: #c15857;">01</span>
          <span style="font-family: 'Work Sans', sans-serif; font-size: 27px; font-weight: 400; line-height: 1.2;">Terrenos residenciales, 1,000–5,000 m²</span>
          <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: #6E655C;">Terrenos encantadores en la ciudad y sus alrededores, en las zonas residenciales arboladas de Los Alcanfores, San Nicolás y Corral de Piedra, entre otras. Son perfectos para autoconstrucción o un proyecto de casa off grid.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 300; color: #c15857;">02</span>
          <span style="font-family: 'Work Sans', sans-serif; font-size: 27px; font-weight: 400; line-height: 1.2;">Predios rurales grandes</span>
          <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: #6E655C;">Más lejos se encuentran predios rurales mucho más grandes, a veces con bosque y arroyos propios, o en el corazón de las montañas con vistas impresionantes sobre Chiapas y más allá.</span>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="background: #221F1C; color: #F2EDE6;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); align-items: stretch;">
      <div style="min-height: 58vh; position: relative; overflow: hidden;">
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1600/f_auto,q_auto/v1788330526/AdobeStock_2087812847_Preview_wbswfo.jpg" alt="Revisando planos sobre un terreno" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <div style="display: flex; flex-direction: column; justify-content: center; gap: 26px; padding: clamp(50px, 8vw, 108px) clamp(24px, 5vw, 92px);">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(242, 237, 230, 0.55);">Debida diligencia</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(26px, 3.52vw, 51px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">Revisado a fondo, antes de que te comprometas</h2>
        <p style="margin: 0; max-width: 44ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: rgba(242, 237, 230, 0.72);">El terreno exige más cuidado que una casa. Con nuestro equipo de arquitectos, valuadores, abogados y notarios se realiza una debida diligencia exhaustiva en cada oportunidad antes de la compra, para que hagas lo que decidas hacer con total confianza.</p>
        <a href="/about-es" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6; border-bottom: 1px solid rgba(242, 237, 230, 0.35); padding-bottom: 5px;">Conoce al equipo</a>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(60px, 10vh, 130px) clamp(20px, 4vw, 56px) clamp(20px, 4vh, 40px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 80px); align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 24px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Después, construye</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(25px, 2.99vw, 46px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">Por ambiciosos que sean tus planes</h2>
        <p style="margin: 0; max-width: 42ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">La enorme variedad de terrenos maravillosos disponibles y los precios realmente competitivos hacen de San Cristóbal uno de los lugares más inteligentes para invertir en terreno, o para crear la casa de tus sueños más ambiciosos.</p>
        <a href="/off-grid-builds-es" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Construcción off grid</a>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2vw, 24px);">
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1200/f_auto,q_auto/v1788115974/LSC_16_iems67.jpg" alt="Una cabaña de madera entre pinos" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: #E4D8C8;" />
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1200/f_auto,q_auto/v1788513859/LSC_33_ypxofq.jpg" alt="Campo verde bajo árboles en un día brillante" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: #E4D8C8; margin-top: clamp(22px, 4vw, 56px);" />
      </div>
    </div>
  </section>

  <ContactCta heading="¿Buscas terreno? Cuéntame qué tienes en mente." lang="es" />
  <Footer lang="es" />
</Layout>
