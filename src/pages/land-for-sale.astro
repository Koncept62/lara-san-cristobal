---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';

const path = Astro.url.pathname;
---
<Layout title="Land for Sale · Lara San Cristóbal">
  <Header esHref="/land-for-sale-es" />
  <MobileMenu currentPath={path} />

  <section id="top" style="position: relative; min-height: 78vh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding: clamp(110px, 16vh, 180px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 72px);">
    <div style="position: absolute; inset: 0; overflow: hidden;">
      <img src="https://res.cloudinary.com/disybpuro/image/upload/w_2000/v1788260708/AdobeStock_82763612_Preview_bekiks.jpg" alt="Rolling land at sunset outside San Cristóbal" style="width: 100%; height: 100%; object-fit: cover; object-position: center 45%;" />
      <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(34, 31, 28, 0.34) 0%, rgba(34, 31, 28, 0.3) 40%, rgba(34, 31, 28, 0.66) 100%);"></div>
    </div>
    <div style="position: relative; max-width: 1400px; width: 100%; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(251, 248, 243, 0.72);">Land for sale</span>
        <h1 style="margin: 0; max-width: 18ch; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(35px, 5.10vw, 84px); line-height: 1.06; letter-spacing: 0.005em; color: #FBF8F3; text-wrap: pretty;">Outstanding value, and views rarely experienced elsewhere</h1>
        <p style="margin: 0; font-size: clamp(17px, 1.7vw, 25px); font-weight: 300; line-height: 1.45; letter-spacing: 0.005em; color: rgba(251, 248, 243, 0.9);">Stunning land at sensible prices…</p>
      </div>
      <p style="margin: 0 0 10px; max-width: 36ch; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(251, 248, 243, 0.86);">Land in and around San Cristóbal presents a very sensible yet compelling case for investment, with some exceptionally beautiful sites available.</p>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(70px, 12vh, 150px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 80px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 86px); align-items: start;">
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(23px, 2.46vw, 35px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;">However just because the prices are low now, don't be fooled into thinking that they will stay that way, this is most certainly a rising market, and investing today should serve you very well tomorrow.</p>
      <div style="display: flex; flex-direction: column; gap: 24px; padding-top: 8px;">
        <p style="margin: 0; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">There are some exceptionally beautiful sites available here, offering truly outstanding value for money, and nature and views rarely experienced elsewhere.</p>
        <a href="#enquire" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Ask what is available</a>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(30px, 5vh, 60px) clamp(20px, 4vw, 56px) clamp(60px, 9vh, 110px);">
    <div style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(30px, 4vw, 46px);">
      <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 30px; border-bottom: 1px solid rgba(43, 38, 34, 0.14);">
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">What is available</h2>
        <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #6E655C;">1,000m² to whole hillsides</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: rgba(43, 38, 34, 0.14);">
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 300; color: #c15857;">01</span>
          <span style="font-family: 'Work Sans', sans-serif; font-size: 27px; font-weight: 400; line-height: 1.2;">Residential plots, 1,000&ndash;5,000m²</span>
          <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: #6E655C;">Really delightful plots in and around the city, in the leafy residential areas of Los Alcanfores, San Nicolás and Corral de Piedra, to name but a few. These would suit a self-build or off-grid home project perfectly.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 300; color: #c15857;">02</span>
          <span style="font-family: 'Work Sans', sans-serif; font-size: 27px; font-weight: 400; line-height: 1.2;">Larger rural land</span>
          <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: #6E655C;">Further afield one can find much larger pieces of rural land, sometimes coming complete with forests and streams, or situated in the heart of the surrounding mountains with the most breathtaking vistas out across Chiapas and beyond.</span>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="background: #221F1C; color: #F2EDE6;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); align-items: stretch;">
      <div style="min-height: 58vh; position: relative; overflow: hidden;">
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1600/v1788330526/AdobeStock_2087812847_Preview_wbswfo.jpg" alt="Reviewing site plans out on a plot of land" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <div style="display: flex; flex-direction: column; justify-content: center; gap: 26px; padding: clamp(50px, 8vw, 108px) clamp(24px, 5vw, 92px);">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(242, 237, 230, 0.55);">Due diligence</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(26px, 3.52vw, 51px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">Checked thoroughly, before you commit</h2>
        <p style="margin: 0; max-width: 44ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: rgba(242, 237, 230, 0.72);">Land needs more care than a house. With our team of architects, valuers, lawyers and notaries, exhaustive due diligence is carried out on each and every opportunity prior to acquisition, so whatever you choose to do, you can do it confidently.</p>
        <a href="/about" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6; border-bottom: 1px solid rgba(242, 237, 230, 0.35); padding-bottom: 5px;">Meet the team</a>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(60px, 10vh, 130px) clamp(20px, 4vw, 56px) clamp(20px, 4vh, 40px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 80px); align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 24px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Then build</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(25px, 2.99vw, 46px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">However ambitious your plans</h2>
        <p style="margin: 0; max-width: 42ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">The sheer range of wonderful land plots available here, and the seriously competitive prices, make San Cristóbal one of the smartest places to consider for a land based investment, or for creating the home of your wildest dreams.</p>
        <a href="/off-grid-builds" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Off grid builds</a>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2vw, 24px);">
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1200/v1788115974/LSC_16_iems67.jpg" alt="A timber cabin among pine trees" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: #E4D8C8;" />
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1200/v1788330526/AdobeStock_131281266_Preview_xfnwb2.jpg" alt="A green field under trees on a bright day" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: #E4D8C8; margin-top: clamp(22px, 4vw, 56px);" />
      </div>
    </div>
  </section>

  <ContactCta heading="Looking for land? Tell me what you have in mind." />
  <Footer />
</Layout>
