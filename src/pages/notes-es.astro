---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';

const path = Astro.url.pathname;

const posts = [
  { num: "01", meta: "Nota 01", title: "Entrada de blog uno", blurb: "Texto por publicar.", img: "/images/colonial-street.jpg", alt: "Calle colonial pintada", featured: true },
  { num: "02", meta: "Nota 02", title: "Entrada de blog dos", blurb: "Texto por publicar.", img: "/images/living-room-plants.jpg", alt: "Sala cálida con plantas" },
  { num: "03", meta: "Nota 03", title: "Entrada de blog tres", blurb: "Texto por publicar.", img: "/images/night-sky.jpg", alt: "Cielo nocturno sobre las montañas" },
  { num: "04", meta: "Nota 04", title: "Entrada de blog cuatro", blurb: "Texto por publicar.", img: "/images/hillside-houses.jpg", alt: "Casas de colores en un cerro" },
  { num: "05", meta: "Nota 05", title: "Entrada de blog cinco", blurb: "Texto por publicar.", img: "/images/mountains-cloud.jpg", alt: "Nubes sobre montañas de altura" },
  { num: "06", meta: "Nota 06", title: "Entrada de blog seis", blurb: "Texto por publicar.", img: "/images/sitting-room-terracotta.jpg", alt: "Sofá terracota con cojines" },
  { num: "07", meta: "Nota 07", title: "Entrada de blog siete", blurb: "Texto por publicar.", img: "/images/dining-room.jpg", alt: "Comedor con mesa de madera" },
  { num: "08", meta: "Nota 08", title: "Entrada de blog ocho", blurb: "Texto por publicar.", img: "/images/bougainvillea-wall.jpg", alt: "Muros blancos con buganvilia" },
  { num: "09", meta: "Nota 09", title: "Entrada de blog nueve", blurb: "Texto por publicar.", img: "/images/cabin-pines.jpg", alt: "Cabaña de madera entre pinos" },
  { num: "10", meta: "Nota 10", title: "Entrada de blog diez", blurb: "Texto por publicar.", img: "/images/bedroom-linen.jpg", alt: "Habitación sencilla con lino" },
];

const filters = ["Todas las notas", "Comprar en México", "Restaurar", "Off grid", "La ciudad", "Interiores"];
const gridPosts = posts.filter(p => !p.featured);
---
<Layout title="Notas · Lara San Cristóbal" lang="es">
  <Header lang="es" enHref="/notes" />
  <MobileMenu currentPath={path} lang="es" />

  <section id="top" style="padding: clamp(130px, 20vh, 220px) clamp(20px, 4vw, 56px) clamp(30px, 5vh, 60px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(26px, 5vw, 90px); align-items: end;">
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Notas</span>
        <h1 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(37px, 5.63vw, 92px); line-height: 0.98; letter-spacing: -0.02em; text-wrap: pretty;">Cosas que vale la pena anotar</h1>
      </div>
      <p style="margin: 0 0 10px; max-width: 40ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">Lo que aprendemos comprando, vendiendo y restaurando casas aquí. Trámites explicados con claridad, constructores de confianza y alguna nota sobre la ciudad misma.</p>
    </div>
  </section>

  <section data-reveal="1" style="padding: 0 clamp(20px, 4vw, 56px) clamp(30px, 5vh, 60px);">
    <div id="filter-bar" style="max-width: 1400px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 10px; padding: 26px 0; border-top: 1px solid rgba(43, 38, 34, 0.14); border-bottom: 1px solid rgba(43, 38, 34, 0.14);">
      {filters.map((f, i) => (
        <button
          type="button"
          class={`filter-btn${i === 0 ? ' active' : ''}`}
          data-filter={f}
          style={`background: ${i === 0 ? '#2B2622' : 'transparent'}; color: ${i === 0 ? '#FBF8F3' : '#6E655C'}; border: 1px solid ${i === 0 ? '#2B2622' : 'rgba(43,38,34,0.22)'}; padding: 10px 18px; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer;`}
        >{f}</button>
      ))}
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(20px, 4vh, 50px) clamp(20px, 4vw, 56px) clamp(40px, 7vh, 80px);">
    <a href="/notes-es" style="display: block; max-width: 1400px; margin: 0 auto;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: clamp(26px, 4vw, 60px); align-items: center;">
        <img src="/images/colonial-street.jpg" alt="Calle colonial pintada" style="width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #E4D8C8;" />
        <div style="display: flex; flex-direction: column; gap: 18px;">
          <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #c15857;">Nota 01</span>
          <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(26px, 3.34vw, 49px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">Entrada de blog uno</h2>
          <p style="margin: 0; max-width: 46ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">Texto por publicar.</p>
          <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px; align-self: flex-start;">Leer la nota</span>
        </div>
      </div>
    </a>
  </section>

  <section data-reveal="1" style="padding: clamp(20px, 4vh, 40px) clamp(20px, 4vw, 56px) clamp(60px, 10vh, 130px);">
    <div id="posts-grid" style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(30px, 3.4vw, 56px) clamp(26px, 3vw, 48px);">
      {gridPosts.map((p) => (
        <a href="/notes-es" class="post-card" data-cat={p.meta} style="display: flex; flex-direction: column; gap: 15px;">
          <img src={p.img} alt={p.alt} style="width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #E4D8C8;" />
          <span style="font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #6E655C;">{p.meta}</span>
          <h3 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 23px; line-height: 1.22; text-wrap: pretty;">{p.title}</h3>
          <p style="margin: 0; font-size: 14px; font-weight: 300; line-height: 1.8; color: #6E655C;">{p.blurb}</p>
        </a>
      ))}
    </div>
    <div style="max-width: 1400px; margin: clamp(40px, 6vh, 70px) auto 0; display: flex; justify-content: center;">
      <button type="button" id="load-more-btn" class="btn-note-more" style="background: none; border: 1px solid rgba(43, 38, 34, 0.24); padding: 16px 34px; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #2B2622; cursor: pointer;">Más notas</button>
    </div>
  </section>

  <section data-reveal="1" style="background: #E9E1D6; padding: clamp(60px, 10vh, 130px) clamp(20px, 4vw, 56px);">
    <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center;">
      <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Una vez al mes, no más</span>
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(25px, 3.34vw, 49px); line-height: 1.14; letter-spacing: -0.015em; text-wrap: pretty;">Casas nuevas, notas nuevas y lo que el clima esté haciéndole a los techos.</p>
      <form id="notes-subscribe-form" style="display: flex; align-items: center; gap: 14px; border-bottom: 1px solid rgba(43, 38, 34, 0.3); padding-bottom: 10px; width: min(420px, 100%);">
        <input type="email" placeholder="Tu correo" style="flex: 1; min-width: 0; background: transparent; border: 0; font-family: 'Work Sans', sans-serif; font-size: 16px; font-weight: 300; color: #2B2622; outline: none;" />
        <button type="submit" id="notes-subscribe-btn" style="background: none; border: 0; padding: 0; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #c15857; cursor: pointer;">Suscribirme</button>
      </form>
    </div>
  </section>

  <Footer lang="es" />

  <script>
    const SHOWN_INIT = 6;
    let shown = SHOWN_INIT;
    const cards = Array.from(document.querySelectorAll('.post-card'));
    const loadMoreBtn = document.getElementById('load-more-btn');

    const applyFilter = (filter) => {
      shown = SHOWN_INIT;
      const matched = filter === 'Todas las notas' ? cards : cards.filter(c => c.dataset.cat === filter);
      cards.forEach(c => { (c as HTMLElement).style.display = 'none'; });
      matched.slice(0, shown).forEach(c => { (c as HTMLElement).style.display = 'flex'; });
      if (loadMoreBtn) {
        loadMoreBtn.textContent = shown >= matched.length ? 'Eso es todo, por ahora' : 'Más notas';
        (loadMoreBtn as HTMLButtonElement).disabled = shown >= matched.length;
      }
      (loadMoreBtn as any)._matched = matched;
    };

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => {
          (b as HTMLElement).style.background = 'transparent';
          (b as HTMLElement).style.color = '#6E655C';
          (b as HTMLElement).style.borderColor = 'rgba(43,38,34,0.22)';
        });
        (btn as HTMLElement).style.background = '#2B2622';
        (btn as HTMLElement).style.color = '#FBF8F3';
        (btn as HTMLElement).style.borderColor = '#2B2622';
        applyFilter((btn as HTMLElement).dataset.filter || 'Todas las notas');
      });
    });

    loadMoreBtn?.addEventListener('click', () => {
      const matched = (loadMoreBtn as any)._matched || cards;
      shown += 3;
      matched.slice(0, shown).forEach(c => { (c as HTMLElement).style.display = 'flex'; });
      if (loadMoreBtn) {
        loadMoreBtn.textContent = shown >= matched.length ? 'Eso es todo, por ahora' : 'Más notas';
        (loadMoreBtn as HTMLButtonElement).disabled = shown >= matched.length;
      }
    });

    applyFilter('Todas las notas');

    document.getElementById('notes-subscribe-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = document.getElementById('notes-subscribe-btn');
      if (btn) btn.textContent = 'Listo';
    });
  </script>
</Layout>
