---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';

const path = Astro.url.pathname;
---
<Layout title="Interior Design & Furniture · Lara San Cristóbal">
  <Header esHref="/interior-design-es" />
  <MobileMenu currentPath={path} />

  <section id="top" style="position: relative; min-height: 78vh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding: clamp(110px, 16vh, 180px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 72px);">
    <div style="position: absolute; inset: 0; overflow: hidden;">
      <img src="https://res.cloudinary.com/disybpuro/image/upload/c_fill,ar_16:9,g_auto,w_2000/f_auto,q_auto/v1788341821/HYL_main_py9a5c.jpg" alt="Interiors and furniture by Humberto y Lara" style="width: 100%; height: 100%; object-fit: cover; object-position: center 45%;" />
      <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(34, 31, 28, 0.34) 0%, rgba(34, 31, 28, 0.3) 40%, rgba(34, 31, 28, 0.66) 100%);"></div>
    </div>
    <div style="position: relative; max-width: 1400px; width: 100%; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(251, 248, 243, 0.72);">Interior design + furniture</span>
        <h1 style="margin: 0; max-width: 18ch; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(35px, 5.10vw, 84px); line-height: 1.06; letter-spacing: 0.005em; color: #FBF8F3; text-wrap: pretty;">A lifetime of luxury interiors, brought home</h1>
        <p style="margin: 0; font-size: clamp(17px, 1.7vw, 25px); font-weight: 300; line-height: 1.45; letter-spacing: 0.005em; color: rgba(251, 248, 243, 0.9);">Exceptional service…</p>
      </div>
      <p style="margin: 0 0 10px; max-width: 36ch; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(251, 248, 243, 0.86);">Twenty-five years delivering luxury real estate and A-list hotels and resorts, working with famously avant garde architects and internationally celebrated designers.</p>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(70px, 12vh, 150px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 70px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 86px); align-items: start;">
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(23px, 2.46vw, 35px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;">Over the course of those 25 years I have developed my own flair for a beautifully creative and unique style aesthetic.</p>
      <div style="display: flex; flex-direction: column; gap: 24px; padding-top: 8px;">
        <p style="margin: 0; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">I offer a complete interior design service for your new property, or if you have your own confident style identity and simply want beautiful, original pieces to place in your home, please do note that I have a furniture and home decoration company, Humberto y Lara.</p>
        <a href="https://humbertoylara.com/" target="_blank" rel="noopener" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Humberto y Lara</a>
      </div>
    </div>
  </section>

  <section id="humberto" data-reveal="1" style="padding: clamp(50px, 8vh, 110px) clamp(20px, 4vw, 56px); background: #E9E1D6;">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 80px); align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 24px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Humberto y Lara</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(26px, 3.34vw, 51px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">Furniture that is so much more than its function</h2>
        <p style="margin: 0; max-width: 42ch; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">Gorgeous pieces that make a style statement, always with a strong sense of individuality and detailing, elevating spaces and bringing editorial standard interior design into your home, executed with flawless, exceptional craftsmanship.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px;">
          <a href="https://humbertoylara.com/furniture/" target="_blank" rel="noopener" class="btn-furniture" style="background: #2B2622; color: #FBF8F3; padding: 16px 30px; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;">Shop furniture</a>
          <a href="https://humbertoylara.com/decoration/" target="_blank" rel="noopener" class="btn-decor" style="border: 1px solid rgba(43, 38, 34, 0.28); padding: 16px 30px; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;">Shop decoration</a>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2vw, 24px);">
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1200/f_auto,q_auto/v1788341714/INSTAGRAM_CONTENT_202534_lqzs7z.jpg" alt="Furniture by Humberto y Lara" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: #E4D8C8;" />
        <img src="https://res.cloudinary.com/disybpuro/image/upload/w_1200/f_auto,q_auto/v1788341715/INSTAGRAM_CONTENT_202542_dyku1m.jpg" alt="Furniture by Humberto y Lara" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: #E4D8C8; margin-top: clamp(22px, 4vw, 56px);" />
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(60px, 10vh, 120px) clamp(20px, 4vw, 56px);">
    <div style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(30px, 4vw, 46px);">
      <p style="margin: 0; max-width: 60ch; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(21px, 2.29vw, 33px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;">From ceramics made here by the wonderful and esteemed Esly Vera, and hand-woven natural cord lamps, mirrors and wall art, to luxurious oversized cushions and sumptuous throw blankets, all mindfully curated to add serious style to your interior.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1px; background: rgba(43, 38, 34, 0.14);">
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 10px; min-height: 170px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">Made in San Cristóbal</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">The entire collection is handmade with love and fine craftsmanship here in the city.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 10px; min-height: 170px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">Shipped across Mexico</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Anywhere in the country, carefully packed and tracked.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(26px, 3vw, 38px); display: flex; flex-direction: column; gap: 10px; min-height: 170px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">Bespoke fitted furniture</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Fully fitted kitchens, wardrobes and storage, made to order by a formidable team of master carpenters.</span>
        </div>
      </div>
    </div>
  </section>

  <ContactCta heading="Furnishing a house here? I would love to help." />
  <Footer />
</Layout>
