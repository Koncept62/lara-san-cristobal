---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';

const path = Astro.url.pathname;
const listings = (await getCollection('property-for-rent'))
  .sort((a, b) => a.data.propertyName.localeCompare(b.data.propertyName));
---
<Layout
  title="Property for Rent · Lara San Cristóbal"
  description="Furnished and unfurnished properties for rent in San Cristóbal de las Casas — monthly and long-stay rentals in the historic centre and residential neighbourhoods."
  esHref="/property-for-rent-es"
>
  <Header esHref="/property-for-rent-es" />
  <MobileMenu currentPath={path} />

  <section id="top" style="position: relative; min-height: 78vh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding: clamp(110px, 16vh, 180px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 72px);">
    <div style="position: absolute; inset: 0; overflow: hidden;">
      <img src="https://res.cloudinary.com/disybpuro/image/upload/f_auto,q_auto/v1788114692/LSC_6_cyh5ex.jpg" alt="Rental property in San Cristóbal de las Casas" style="width: 100%; height: 100%; object-fit: cover; object-position: center 45%;" />
      <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(34, 31, 28, 0.34) 0%, rgba(34, 31, 28, 0.3) 40%, rgba(34, 31, 28, 0.66) 100%);"></div>
    </div>
    <div style="position: relative; max-width: 1400px; width: 100%; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(251, 248, 243, 0.72);">Property for rent</span>
        <h1 style="margin: 0; max-width: 18ch; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(35px, 5.10vw, 84px); line-height: 1.06; letter-spacing: 0.005em; color: #FBF8F3; text-wrap: pretty;">A great property, with a trustworthy landlord</h1>
        <p style="margin: 0; font-size: clamp(17px, 1.7vw, 25px); font-weight: 300; line-height: 1.45; letter-spacing: 0.005em; color: rgba(251, 248, 243, 0.9);">A formidable team to assist you</p>
      </div>
      <p style="margin: 0 0 10px; max-width: 36ch; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(251, 248, 243, 0.86);">The rental market here moves very quickly, so the best places rarely make it onto a listings page.</p>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(70px, 12vh, 150px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 80px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 86px); align-items: start;">
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(23px, 2.46vw, 35px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;">We usually always have a range of high quality rental properties available, but as the market here for well presented, well located properties can move very quickly, there isn't always time to post our listings.</p>
      <div style="display: flex; flex-direction: column; gap: 24px; padding-top: 8px;">
        <p style="margin: 0; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">Please therefore kindly contact me directly if you are looking to rent here in San Cristóbal, and we will do our best to match you up with a great property that comes, of course, with a reliable and trustworthy landlord.</p>
        <p style="margin: 0; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">We are here to assist you throughout the entire process, so please get in touch and share your budget and wish list, so we can prepare a shortlist of appropriate properties for you, and then we can start viewing as soon as you are ready.</p>
        <a href="#enquire" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Send your wish list</a>
      </div>
    </div>
  </section>

  {listings.length > 0 && (
    <section data-reveal="1" style="padding: clamp(20px, 4vh, 50px) clamp(20px, 4vw, 56px) clamp(50px, 8vh, 100px);">
      <div style="max-width: 1400px; margin: 0 auto;">
        <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 40px; border-bottom: 1px solid rgba(43, 38, 34, 0.14);">
          <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Currently available</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(28px, 3.4vw, 54px); padding-top: clamp(34px, 4vw, 56px);">
          {listings.map(entry => {
            const slug = entry.id.replace(/\.md$/, '');
            const d = entry.data;
            return (
              <a href={`/property-for-rent/${slug}`} style="display: flex; flex-direction: column; gap: 20px;">
                <div style="position: relative; overflow: hidden; aspect-ratio: 3 / 4; background: #E4D8C8;">
                  <img src={d.mainImage} alt={d.propertyName} style="width: 100%; height: 100%; object-fit: cover;" />
                  {d.status === 'Reserved' && <span style="position: absolute; top: 16px; left: 16px; background: rgba(34, 31, 28, 0.78); padding: 6px 12px; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6;">Let agreed</span>}
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <h3 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 24px; line-height: 1.2;">{d.propertyName}</h3>
                  <p style="margin: 0; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #6E655C;">{d.location}{d.bedrooms ? ` · ${d.bedrooms} bed` : ''}{d.propertySize ? ` · ${d.propertySize}` : ''}</p>
                  <p style="margin: 4px 0 0; font-size: 14px; font-weight: 300; line-height: 1.75; color: #6E655C;">{d.inBrief}</p>
                  <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 4px;">
                    {d.priceMxn ? (
                      <>
                        <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 400; letter-spacing: 0.005em; color: #c15857;">{d.priceMxn} / month</span>
                        {d.priceUsd && <span style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8C8175;">≈ {d.priceUsd} USD guide</span>}
                      </>
                    ) : (
                      <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #c15857;">Enquire for price</span>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section data-reveal="1" style="background: #221F1C; color: #F2EDE6;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); align-items: stretch;">
      <div style="min-height: 56vh; position: relative; overflow: hidden;">
        <img src="https://res.cloudinary.com/disybpuro/image/upload/f_auto,q_auto/v1788114747/LSC_3_ld5awb.jpg" alt="Interior of a rental property in San Cristóbal" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <div style="display: flex; flex-direction: column; justify-content: center; gap: 26px; padding: clamp(50px, 8vw, 108px) clamp(24px, 5vw, 92px);">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(242, 237, 230, 0.55);">How it works</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(26px, 3.34vw, 49px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">Three steps, and you are viewing</h2>
        <div style="display: flex; flex-direction: column; gap: 1px; background: rgba(242, 237, 230, 0.14);">
          <div style="background: #221F1C; padding: 20px 0; display: flex; gap: 20px; align-items: baseline;">
            <span style="font-family: 'Work Sans', sans-serif; font-size: 23px; font-weight: 300; color: #c15857; min-width: 34px;">01</span>
            <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: rgba(242, 237, 230, 0.8);">Tell me your budget, your wish list, and when you would like to move.</span>
          </div>
          <div style="background: #221F1C; padding: 20px 0; display: flex; gap: 20px; align-items: baseline;">
            <span style="font-family: 'Work Sans', sans-serif; font-size: 23px; font-weight: 300; color: #c15857; min-width: 34px;">02</span>
            <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: rgba(242, 237, 230, 0.8);">We prepare a shortlist of appropriate properties, listed and unlisted.</span>
          </div>
          <div style="background: #221F1C; padding: 20px 0; display: flex; gap: 20px; align-items: baseline;">
            <span style="font-family: 'Work Sans', sans-serif; font-size: 23px; font-weight: 300; color: #c15857; min-width: 34px;">03</span>
            <span style="font-size: 14px; font-weight: 300; line-height: 1.8; color: rgba(242, 237, 230, 0.8);">We start viewing as soon as you are ready, and stay with you through the paperwork.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(60px, 10vh, 130px) clamp(20px, 4vw, 56px) clamp(20px, 4vh, 40px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(16px, 2vw, 26px);">
      <img src="https://res.cloudinary.com/disybpuro/image/upload/f_auto,q_auto/v1788114692/LSC_2_y0krs2.jpg" alt="Living space in a San Cristóbal rental" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: #E4D8C8;" />
      <img src="https://res.cloudinary.com/disybpuro/image/upload/f_auto,q_auto/v1788114801/LSC_5_z9yibm.jpg" alt="Room in a San Cristóbal rental property" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: #E4D8C8;" />
      <img src="https://res.cloudinary.com/disybpuro/image/upload/f_auto,q_auto/v1788114692/LSC_1_pejjvf.jpg" alt="Rental property interior in San Cristóbal" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: #E4D8C8;" />
    </div>
  </section>

  <ContactCta heading="Looking for somewhere to rent? Message me directly." />
  <Footer />
</Layout>
