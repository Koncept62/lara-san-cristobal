---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';

const path = Astro.url.pathname;
const listings = (await getCollection('property-for-sale'))
  .sort((a, b) => a.data.propertyName.localeCompare(b.data.propertyName));
---
<Layout title="Property for Sale · Lara San Cristóbal">
  <Header esHref="/property-for-sale-es" />
  <MobileMenu currentPath={path} />

  <section id="top" style="position: relative; min-height: 78vh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding: clamp(110px, 16vh, 180px) clamp(20px, 4vw, 56px) clamp(40px, 6vh, 72px);">
    <div style="position: absolute; inset: 0; overflow: hidden;">
      <img src="/images/colonnade-courtyard.jpg" alt="Arched colonnade around a courtyard" style="width: 100%; height: 100%; object-fit: cover; object-position: center 45%;" />
      <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(34, 31, 28, 0.34) 0%, rgba(34, 31, 28, 0.3) 40%, rgba(34, 31, 28, 0.66) 100%);"></div>
    </div>
    <div style="position: relative; max-width: 1400px; width: 100%; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(251, 248, 243, 0.72);">Property for sale</span>
        <h1 style="margin: 0; max-width: 18ch; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(35px, 5.10vw, 84px); line-height: 1.06; letter-spacing: 0.005em; color: #FBF8F3; text-wrap: pretty;">Some very worthy options</h1>
        <p style="margin: 0; font-size: clamp(17px, 1.7vw, 25px); font-weight: 300; line-height: 1.45; letter-spacing: 0.005em; color: rgba(251, 248, 243, 0.9);">Characterful properties, excellent value…</p>
      </div>
      <p style="margin: 0 0 10px; max-width: 36ch; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(251, 248, 243, 0.86);">Tell me your wishes, preferences, absolute non-negotiables and budget, and we will go from there.</p>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(70px, 12vh, 150px) clamp(20px, 4vw, 56px) clamp(30px, 5vh, 60px);">
    <div style="max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(30px, 5vw, 86px); align-items: start;">
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(23px, 2.46vw, 35px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty;">If you are ready to investigate purchasing a property in San Cristóbal, please kindly get in touch via WhatsApp or email me directly.</p>
      <div style="display: flex; flex-direction: column; gap: 24px; padding-top: 8px;">
        <p style="margin: 0; font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">Whether you have decided on a favourite spot, such as the sought after areas of Los Alcanfores, San Nicolás or maybe Corral de Piedra, or if you are focused on being in the heart of the glorious historic centre, or perhaps looking for something a little more rural outside of the city, I am confident we can offer some very worthy options.</p>
        <a href="#enquire" style="align-self: flex-start; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid rgba(43, 38, 34, 0.28); padding-bottom: 5px;">Start a conversation</a>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(30px, 5vh, 60px) clamp(20px, 4vw, 56px) clamp(50px, 8vh, 100px);">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 40px; border-bottom: 1px solid rgba(43, 38, 34, 0.14);">
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Currently on our books</h2>
        <a href="/property-for-rent" style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #6E655C;">Looking to rent instead?</a>
      </div>
      {listings.length > 0 ? (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(28px, 3.4vw, 54px); padding-top: clamp(34px, 4vw, 56px);">
          {listings.map(entry => {
            const slug = entry.id.replace(/\.md$/, '');
            const d = entry.data;
            return (
              <a href={`/property-for-sale/${slug}`} style="display: flex; flex-direction: column; gap: 20px;">
                <div style="position: relative; overflow: hidden; aspect-ratio: 3 / 4; background: #E4D8C8;">
                  <img src={d.mainImage} alt={d.propertyName} style="width: 100%; height: 100%; object-fit: cover;" />
                  {d.status === 'Reserved' && <span style="position: absolute; top: 16px; left: 16px; background: rgba(34, 31, 28, 0.78); padding: 6px 12px; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6;">Reserved</span>}
                  {d.status === 'Sold' && <span style="position: absolute; top: 16px; left: 16px; background: rgba(34, 31, 28, 0.78); padding: 6px 12px; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #F2EDE6;">Sold</span>}
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <h3 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 24px; line-height: 1.2;">{d.propertyName}</h3>
                  <p style="margin: 0; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #6E655C;">{d.location}{d.bedrooms ? ` · ${d.bedrooms} bed` : ''}</p>
                  <p style="margin: 4px 0 0; font-size: 14px; font-weight: 300; line-height: 1.75; color: #6E655C;">{d.inBrief}</p>
                  <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 4px;">
                    {d.priceMxn ? (
                      <>
                        <span style="font-family: 'Work Sans', sans-serif; font-size: 19px; font-weight: 400; letter-spacing: 0.005em; color: #c15857;">{d.priceMxn}</span>
                        {d.priceUsd && <span style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8C8175;">≈ {d.priceUsd} USD guide</span>}
                      </>
                    ) : (
                      <span style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #c15857;">Enquire for price</span>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p style="padding-top: clamp(34px, 4vw, 56px); font-size: 15px; font-weight: 300; line-height: 1.9; color: #6E655C;">New listings are added regularly — please get in touch and we will share what we have available, including off-market opportunities.</p>
      )}
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(50px, 8vh, 110px) clamp(20px, 4vw, 56px); background: #E9E1D6;">
    <div style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(30px, 4vw, 46px);">
      <div style="display: flex; flex-direction: column; gap: 20px; max-width: 46ch;">
        <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Where to look</span>
        <h2 style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(26px, 3.34vw, 49px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: pretty;">The areas people ask for most</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; background: rgba(43, 38, 34, 0.14);">
        <div style="background: #F2EDE6; padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 10px; min-height: 160px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">Los Alcanfores</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Sought after, leafy and residential, a short drive from the centre.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 10px; min-height: 160px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">San Nicolás</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Quiet streets, generous plots, and a steady rental demand.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 10px; min-height: 160px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">Corral de Piedra</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Green, spacious, and popular with self-build and off-grid projects.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 10px; min-height: 160px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">The historic centre</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Older, characterful properties worth improving, in the heart of the city.</span>
        </div>
        <div style="background: #F2EDE6; padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 10px; min-height: 160px;">
          <span style="font-family: 'Work Sans', sans-serif; font-size: 26px; font-weight: 400; line-height: 1.25;">Rural, outside the city</span>
          <span style="font-size: 13px; font-weight: 300; line-height: 1.75; color: #6E655C;">Larger pieces of land with forests, streams and mountain views.</span>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="padding: clamp(60px, 10vh, 120px) clamp(20px, 4vw, 56px);">
    <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center;">
      <span style="font-family: 'Work Sans', sans-serif; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: #6E655C;">Off-market</span>
      <p style="margin: 0; font-family: 'Work Sans', sans-serif; font-weight: 200; font-size: clamp(23px, 2.99vw, 40px); line-height: 1.2; letter-spacing: -0.01em; text-wrap: pretty;">Not all properties currently for sale are listed on this page, so please do connect with me, as there may be off-market listings that might just be perfect for you.</p>
    </div>
  </section>

  <ContactCta heading="Ready to look? Send me your wish list." />
  <Footer />
</Layout>
